{
  "name": "paperstreet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply paperstreet --local",
    "db:remote": "wrangler d1 migrations apply paperstreet --remote",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.4.0",
    "hono": "^4.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "node-domexception": "file:./vendor/node-domexception"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "wrangler": "^4.165.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "node-domexception": "$node-domexception"
  }
}
