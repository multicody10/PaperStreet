# Discord credentials. Never commit .dev.vars or send keys to the frontend.
DISCORD_CLIENT_ID="YOUR_DISCORD_APPLICATION_ID"
DISCORD_PUBLIC_KEY="YOUR_DISCORD_APPLICATION_PUBLIC_KEY"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHARACTER_SECRET"
# Real prices are the only market source. Obtain Finnhub's written redistribution approval
# before displaying data to third-party Discord players. No simulated fallback exists.
FINNHUB_API_KEY="YOUR_APPROVED_PROVIDER_KEY"
