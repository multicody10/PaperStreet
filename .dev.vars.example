# From the Discord Developer Portal. Do NOT commit .dev.vars.
DISCORD_CLIENT_ID="YOUR_DISCORD_APPLICATION_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
# Generate with: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHARACTER_SECRET"
# Optional for FINNHUB mode only. Confirm licensing for your audience.
FINNHUB_API_KEY=""
